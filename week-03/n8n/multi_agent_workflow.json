    {
      "parameters": {
        "jsCode": "const classifier = $('Merge Classifier Validation').first().json.output || {};\nconst extractor = $('Merge Extractor Validation').first().json.output || {};\n\n// Union both agent outputs under a single \"output\" object.\n// The keys never overlap (classifier: intent/category/priority/confidence,\n// extractor: full_name/email/company/partner_code/request), so nothing is lost.\nreturn [{ json: { output: { ...classifier, ...extractor } } }];"
      },
      "id": "4bbcd226-71aa-4909-9bea-eaa2e9c9365e",
      "name": "Combine Lead Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
