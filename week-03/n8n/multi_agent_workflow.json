    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\n// Consider a Google Sheets row valid only when it carries a non-empty partner_code.\nconst match = items.find((i) => {\n  const j = i.json || {};\n  return j.partner_code !== undefined && j.partner_code !== null && String(j.partner_code).trim() !== '';\n});\n\nif (match) {\n  const j = match.json;\n  return [{\n    json: {\n      row_number: j.row_number ?? null,\n      partner_code: j.partner_code ?? '',\n      partner_name: j.partner_name ?? '',\n      partner_email: j.partner_email ?? '',\n      active: j.active ?? false,\n      partner_verified: true,\n    },\n  }];\n}\n\n// No matching / invalid partner: emit the deterministic fallback partner object.\nreturn [{\n  json: {\n    row_number: null,\n    partner_code: '',\n    partner_name: '',\n    partner_email: '',\n    active: false,\n    partner_verified: false,\n  },\n}];"
      },
